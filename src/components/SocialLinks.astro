---
import { faGithub, faItchIo, faYoutube, faLinkedin } from '@fortawesome/free-brands-svg-icons';
import { faEnvelope } from '@fortawesome/free-solid-svg-icons';
import { SOCIAL_LINKS } from '../consts';

// Map the names used in consts.ts to icon data
const icons: Record<string, typeof faGithub> = {
    github: faGithub,
    itch: faItchIo,
    linkedin: faLinkedin,
    email: faEnvelope,
};
---
<ul class="social-links">
    {SOCIAL_LINKS.map((link) => {
    const [width, height, , , path] = icons[link.icon].icon;
    return (
        <li>
        <a
            href={link.href}
            aria-label={link.label}
            title={link.label}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel="noopener noreferrer"
        >
            <svg viewBox={`0 0 ${width} ${height}`} aria-hidden="true" focusable="false">
            <path d={path as string} fill="currentColor" />
            </svg>
        </a>
        </li>
    );
    })}
</ul>

<style>
    .social-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    }
    a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 3px;
    color: rgb(var(--gray-dark));
    }
    a:hover {
    border-color: var(--accent);
    color: var(--accent);
    }
    svg {
    width: 1.2rem;
    height: 1.2rem;
    display: block;
    }
</style>
---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('project'))
.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
.slice(0, 2);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Hi, I'm Jacob</h1>
				<p>
				I'm a game developer / audio designer based in Christchurch. I build a bit of everything, but my main focus is on gameplay systems and audio design,
				mostly in Unity. Below are my latest projects.
				</p>
			</section>

			<section class="recent">
			<h2>Recent projects</h2>
			<ul>
				{projects.map((project) => (
				<li>
					<a href={`/projects/${project.id}/`}>
					{project.data.heroImage && (
						<Image width={720} height={360} src={project.data.heroImage} alt="" />
					)}
					<h3>{project.data.title}</h3>
					<p>{project.data.description}</p>
					</a>
				</li>
				))}
			</ul>
			<a href="/projects/">See all projects</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-bottom: 4rem;
	}
	.intro p {
		max-width: 60ch;
		font-size: 1.25rem;
	}
	.cv {
		display: inline-block;
		margin-top: 0.5rem;
		padding: 0.55em 1.1em;
		border: 1px solid var(--accent);
		border-radius: 3px;
		text-decoration: none;
	}
	.cv:hover {
		background: var(--accent);
		color: var(--bg);
	}
	.recent ul {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
		list-style: none;
		margin: 1.5rem 0;
		padding: 0;
	}
	.recent li a {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.recent li img {
		width: 100%;
		height: auto;
		margin-bottom: 0.8rem;
	}
	.recent h3 {
		margin: 0 0 0.3rem;
	}
	.recent li a:hover h3 {
		color: var(--accent);
	}
	.recent li p {
		margin: 0;
		color: rgb(var(--gray));
	}
	@media (max-width: 720px) {
		.recent ul {
		grid-template-columns: 1fr;
		}
	}
</style>
